},
"79": {
&"character": "Fisherman",
&"id": "79",
&"next_id": "80",
&"static_id": "",
&"text": "You there! Yeah, I'm talking to you, Mr. Sunshine!",
&"type": "dialogue"
},
"8": {
&"id": "8",
&"next_id": "9",
&"type": ""
},
"80": {
&"id": "80",
&"next_id": "81",
&"responses": PackedStringArray("80", "88"),
&"static_id": "",
&"text": "Did you just call me Mr. Sunshine?",
&"type": "response"
},
"81": {
&"character": "Fisherman",
&"id": "81",
&"next_id": "82",
&"static_id": "",
&"text": "Sure did, Sunshine! You know, because since your such a bright ray of sunshine the way you frown and do your litte detective pose!",
&"type": "dialogue"
},
"82": {
&"character": "Fisherman",
&"id": "82",
&"next_id": "83",
&"static_id": "",
&"text": "Enough about that though, Sunshine. I could use the help of a strong man like you! How about you catch me some fish and I'll give you a litle something something for your troubles. How's that sound for you?",
&"type": "dialogue"
},
